# Generated by martinx/handrail's release workflow. Do not edit by hand.
class Handrail < Formula
  desc "Policy packs for coding agents: enforced where the agent allows it"
  homepage "https://handrail.bitey.ai"
  version "@VERSION@"
  license "Apache-2.0"

  on_macos do
    on_arm do
      url "https://github.com/martinx/handrail/releases/download/v@VERSION@/handrail-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_aarch64-apple-darwin@"
    end
    on_intel do
      url "https://github.com/martinx/handrail/releases/download/v@VERSION@/handrail-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA_x86_64-apple-darwin@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/martinx/handrail/releases/download/v@VERSION@/handrail-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_aarch64-unknown-linux-musl@"
    end
    on_intel do
      url "https://github.com/martinx/handrail/releases/download/v@VERSION@/handrail-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_x86_64-unknown-linux-musl@"
    end
  end

  def install
    bin.install "handrail"
  end

  def caveats
    <<~EOS
      Handrail runs itself through sudo to change enforced policy. The Homebrew prefix is
      writable by your user, so anything running as you could replace the binary before
      sudo runs it. For enforced policy, the install script (which installs to the
      root-owned /usr/local/bin) is the safer choice:
        curl -fsSL https://handrail.bitey.ai/install.sh | sh
      Run `handrail doctor` to check.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/handrail --version")
  end
end
