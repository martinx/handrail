{
  "disableRemoteControl": true,
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": false,
  "inputNeededNotifEnabled": false,
  "enableArtifact": false,
  "disableClaudeAiConnectors": true,
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "feedbackSurveyRate": 0,
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_TELEMETRY": "1",
    "DO_NOT_TRACK": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "deny": ["Artifact", "ArtifactComments", "ArtifactData", "RemoteTrigger", "PushNotification", "SendFeedback"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Artifact.*|RemoteTrigger|PushNotification|SendFeedback|Agent|Task|Workflow|mcp__claude_ai_.*",
        "hooks": [{ "type": "command", "command": "\"@HANDRAIL_HOOKS@/10-privacy-guard.sh\"" }]
      }
    ]
  }
}
